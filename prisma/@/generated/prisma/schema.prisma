// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js" // ← CHANGE ICI (standard pour SQLite/Node.js)
  output   = "@/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Devis {
  id        Int      @id @default(autoincrement())
  fullname  String
  email     String
  phone     String
  service   String
  message   String
  budget    Int
  createdAt DateTime @default(now())
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  sujet     String
  phone     String
  service   String
  message   String
  createdAt DateTime @default(now())
}
