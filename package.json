    "@react-email/render": "^2.0.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.22",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.1.0",
